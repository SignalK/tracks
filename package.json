{
  "name": "@signalk/tracks-plugin",
  "version": "2.0.2",
  "description": "Plugin to keep track of tracks of vessels",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "//main": "Signal K resolves an installed plugin by directory. Node's CJS directory resolution and the server's esm-resolve fallback both read `main`, not `exports`, so dropping this makes the plugin unloadable.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility"
  ],
  "author": "Teppo Kurki <teppo.kurki@iki.fi>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SignalK/tracks.git"
  },
  "bugs": {
    "url": "https://github.com/SignalK/tracks/issues"
  },
  "homepage": "https://github.com/SignalK/tracks#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "rxjs": "^7.8.2",
    "s2js": "^1.44.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.2",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
